@page "/tournaments"
@rendermode InteractiveServer
@using MYCHESS_CLUB.Models
@using MYCHESS_CLUB.Services
@inject TournamentService TournamentService

<PageTitle>Tournaments - Lucky Stars Chess Club</PageTitle>

<div class="page-header">
    <div class="page-header-icon">🏆♟️</div>
    <h1>Chess Tournaments</h1>
    <p>Checkmate the Odds</p>
</div>

<section class="tournament-section">
    <h2>Upcoming Tournaments</h2>

    <div class="tournament-list">
        @if (tournaments == null)
        {
            <p>Loading tournaments...</p>
        }
        else
        {
            @foreach (var tournament in tournaments)
            {
                <div class="tournament-card">
                    <div class="tournament-icon">🏆</div>
                    <div class="tournament-info">
                        <h3>@tournament.Name</h3>
                        <p>@tournament.Description</p>

                        <div class="tournament-details">
                            <p><strong>📅 Date:</strong> @tournament.Date.ToShortDateString()</p>
                            <p><strong>📍 Location:</strong> @tournament.Location</p>
                            <p><strong>♟️ Format:</strong> @tournament.Format</p>
                            <p><strong>👥 Eligibility:</strong> @tournament.Eligibility</p>
                            <p><strong>✅ Registered:</strong> @TournamentService.GetParticipants(tournament.Id).Count</p>
                        </div>

                        <div class="register-row">
                            <input @bind="nameInputs[tournament.Id]" placeholder="Your name" class="register-input" />
                            <button @onclick="() => RegisterInterest(tournament)">Register Interest</button>
                        </div>

                        @if (registeredTournamentId == tournament.Id)
                        {
                            <p class="success-message">✅ Your interest in this tournament has been recorded!</p>
                        }

                        <p><a href="@($"/tournaments/{tournament.Id}/bracket")">View Bracket →</a></p>
                    </div>
                </div>
            }
        }
    </div>
</section>

<section class="tournament-section">
    <h2>Why Participate?</h2>
    <div class="tournament-benefits">
        <div class="benefit-card">
            <span>🧠</span>
            <h3>Improve</h3>
            <p>Challenge yourself and improve your decision-making and chess skills.</p>
        </div>
        <div class="benefit-card">
            <span>🏆</span>
            <h3>Compete</h3>
            <p>Gain tournament experience and test your abilities.</p>
        </div>
        <div class="benefit-card">
            <span>🤝</span>
            <h3>Connect</h3>
            <p>Meet fellow chess players and become part of our community.</p>
        </div>
    </div>
</section>

<section class="tournament-section">
    <h2>Past Results</h2>
    <p>Tournament results will appear here after our first official competitions.</p>
</section>

@code {
    private List<Tournament>? tournaments;
    private int? registeredTournamentId;
    private Dictionary<int, string> nameInputs = new();

    protected override void OnInitialized()
    {
        tournaments = TournamentService.GetTournaments();
        foreach (var t in tournaments)
            nameInputs[t.Id] = string.Empty;
    }

    private void RegisterInterest(Tournament tournament)
    {
        var name = nameInputs.GetValueOrDefault(tournament.Id, string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(name))
            return;

        TournamentService.RegisterParticipant(tournament.Id, name);
        registeredTournamentId = tournament.Id;
        nameInputs[tournament.Id] = string.Empty;
    }
}