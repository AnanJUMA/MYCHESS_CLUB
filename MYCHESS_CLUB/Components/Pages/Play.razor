@page "/play"
@rendermode InteractiveServer
@using MYCHESS_CLUB.Models
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Play Chess - Lucky Stars Chess Club</PageTitle>

<div class="play-container">
    <h1>♟️ Play Chess</h1>
    <div class="game-info">
        <span class="turn-indicator">
            Turn: <strong>@(CurrentTurn == PieceColor.White ? "White" : "Black")</strong>
            @if (Mode == OpponentMode.Ai && CurrentTurn == AiColor && !GameOver)
            {
                <span class="ai-badge">AI</span>
            }
        </span>

        <div class="opponent-picker">
            <span>Opponent:</span>
            <select value="@Mode" @onchange="OnOpponentModeChanged">
                <option value="Human">Human</option>
                <option value="Ai">AI</option>
            </select>

            @if (Mode == OpponentMode.Ai)
            {
                <select value="@SelectedDifficulty" @onchange="OnDifficultyChanged">
                    @foreach (var d in Enum.GetValues<AiDifficulty>())
                    {
                        <option value="@d">@d</option>
                    }
                </select>

                <select value="@HumanColor" @onchange="OnHumanColorChanged">
                    <option value="White">Play as White</option>
                    <option value="Black">Play as Black</option>
                </select>
            }
        </div>

        <div class="time-control-picker">
            <span>Time:</span>
            @foreach (var preset in TimeControlPresets)
            {
                <button class="@(SelectedTimeControlMinutes == preset ? "preset-active" : "")"
                        @onclick="() => SetTimeControl(preset)">
                    @preset min
                </button>
            }
        </div>

        <button @onclick="ResetGame">🔄 Reset</button>
    </div>

    @if (AiThinking)
    {
        <div class="status-message thinking">🤔 AI is thinking...</div>
    }
    else if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="status-message @(GameOver ? "checkmate" : "check")">
            @StatusMessage
        </div>
    }

    <div class="player-panel">
        <div class="captured-tray">
            @foreach (var p in CapturedWhitePieces)
            {
                <span class="captured-piece white">@p.UnicodeSymbol</span>
            }
        </div>
        <div class="clock @(CurrentTurn == PieceColor.White && !GameOver ? "active" : "") @(WhiteSecondsRemaining <= 30 ? "low-time" : "")">
            @FormatTime(WhiteSecondsRemaining)
        </div>
    </div>

    <div class="game-layout">
        <div class="board-wrapper">
            <div class="board">
                @for (int r = 7; r >= 0; r--)
                {
                    var row = r;

                    <div class="board-row">
                        @for (int c = 0; c < 8; c++)
                        {
                            var col = c;

                            var piece = Board[row, col];
                            var isLight = (row + col) % 2 == 0;
                            var isSelected = SelectedSquare?.Row == row && SelectedSquare?.Col == col;
                            var isKingInCheckSquare = piece != null
                                && piece.Type == PieceType.King
                                && ((piece.Color == PieceColor.White && WhiteInCheck) || (piece.Color == PieceColor.Black && BlackInCheck));
                            var isLegalTarget = LegalTargets.Contains((row, col));
                            var isCaptureTarget = isLegalTarget && piece != null;
                            var isLastMove = (LastMoveFrom != null && LastMoveFrom.Row == row && LastMoveFrom.Col == col)
                                || (LastMoveTo != null && LastMoveTo.Row == row && LastMoveTo.Col == col);
                            var isDraggable = piece != null && piece.Color == CurrentTurn && !GameOver && !PendingPromotion && !AiThinking;

                            var cssClass = $"square {(isLight ? "light" : "dark")}"
                                + $" {(isSelected ? "selected" : "")}"
                                + $" {(isKingInCheckSquare ? "king-check" : "")}"
                                + $" {(isLastMove ? "last-move" : "")}"
                                + $" {(isLegalTarget ? (isCaptureTarget ? "legal-target capture-target" : "legal-target") : "")}";

                            <div class="@cssClass"
                                 draggable="@(isDraggable ? "true" : "false")"
                                 @ondragstart="() => OnDragStart(row, col)"
                                 @ondragover:preventDefault
                                 @ondrop="() => OnDrop(row, col)"
                                 @onclick="() => OnSquareClick(row, col)">
                                @if (piece != null)
                                {
                                    <span class="piece" style="color: @(piece.Color == PieceColor.White ? "#fff" : "#000")">
                                        @piece.UnicodeSymbol
                                    </span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="move-history">
            <h3>Moves</h3>
            <div class="move-history-list">
                @for (int i = 0; i < MoveHistory.Count; i += 2)
                {
                    var moveNumber = (i / 2) + 1;
                    var whiteMove = MoveHistory[i];
                    var blackMove = (i + 1 < MoveHistory.Count) ? MoveHistory[i + 1] : "";

                    <div class="move-history-item">
                        <span class="move-number">@moveNumber.</span>
                        <span class="move-white">@whiteMove</span>
                        <span class="move-black">@blackMove</span>
                    </div>
                }
                @if (MoveHistory.Count == 0)
                {
                    <div class="move-history-empty">No moves yet</div>
                }
            </div>
        </div>
    </div>

    <div class="player-panel">
        <div class="captured-tray">
            @foreach (var p in CapturedBlackPieces)
            {
                <span class="captured-piece black">@p.UnicodeSymbol</span>
            }
        </div>
        <div class="clock @(CurrentTurn == PieceColor.Black && !GameOver ? "active" : "") @(BlackSecondsRemaining <= 30 ? "low-time" : "")">
            @FormatTime(BlackSecondsRemaining)
        </div>
    </div>

    @if (PendingPromotion && PromotionSquare != null)
    {
        var promoColor = Board[PromotionSquare.Row, PromotionSquare.Col]?.Color ?? PieceColor.White;
        <div class="promotion-overlay">
            <div class="promotion-modal">
                <p>Promote pawn to:</p>
                <div class="promotion-choices">
                    @foreach (var choice in new[] { PieceType.Queen, PieceType.Rook, PieceType.Bishop, PieceType.Knight })
                    {
                        var pieceForSymbol = new ChessPiece { Color = promoColor, Type = choice };
                        <button class="promotion-choice" @onclick="() => CompletePromotion(choice)">
                            @pieceForSymbol.UnicodeSymbol
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ChessPiece?[,] Board = new ChessPiece?[8, 8];
    private PieceColor CurrentTurn = PieceColor.White;
    private Square? SelectedSquare = null;

    private List<ChessPiece> CapturedBlackPieces = new();
    private List<ChessPiece> CapturedWhitePieces = new();

    private bool GameOver = false;
    private string StatusMessage = "";

    private Square? EnPassantTarget = null;

    private bool PendingPromotion = false;
    private Square? PromotionSquare = null;
    private string? PendingMoveNotation = null;
    private bool PendingMoveWasCapture = false;

    private List<string> MoveHistory = new();
    private Square? LastMoveFrom = null;
    private Square? LastMoveTo = null;
    private HashSet<(int Row, int Col)> LegalTargets = new();

    private bool WhiteInCheck => ChessRules.IsKingInCheck(Board, PieceColor.White);
    private bool BlackInCheck => ChessRules.IsKingInCheck(Board, PieceColor.Black);

    // ---- Clock ----
    private readonly int[] TimeControlPresets = { 5, 10, 15 };
    private int SelectedTimeControlMinutes = 10;
    private int WhiteSecondsRemaining;
    private int BlackSecondsRemaining;
    private System.Timers.Timer? GameClock;
    private bool GameStarted = false;

    // ---- AI opponent ----
    private enum OpponentMode { Human, Ai }
    private OpponentMode Mode = OpponentMode.Human;
    private AiDifficulty SelectedDifficulty = AiDifficulty.Club;
    private PieceColor HumanColor = PieceColor.White;
    private bool AiThinking = false;
    private readonly ChessAi Ai = new();

    private PieceColor AiColor => Opponent(HumanColor);

    protected override void OnInitialized()
    {
        ResetGame();
    }

    private void ResetGame()
    {
        Board = new ChessPiece?[8, 8];
        CurrentTurn = PieceColor.White;
        SelectedSquare = null;
        CapturedBlackPieces = new();
        CapturedWhitePieces = new();
        GameOver = false;
        StatusMessage = "";
        EnPassantTarget = null;
        PendingPromotion = false;
        PromotionSquare = null;
        PendingMoveNotation = null;
        PendingMoveWasCapture = false;
        MoveHistory = new();
        LastMoveFrom = null;
        LastMoveTo = null;
        LegalTargets.Clear();

        WhiteSecondsRemaining = SelectedTimeControlMinutes * 60;
        BlackSecondsRemaining = SelectedTimeControlMinutes * 60;
        GameStarted = false;
        StopClock(); // clock only starts once the first move is made

        for (int col = 0; col < 8; col++)
        {
            Board[1, col] = new ChessPiece { Color = PieceColor.Black, Type = PieceType.Pawn };
            Board[6, col] = new ChessPiece { Color = PieceColor.White, Type = PieceType.Pawn };
        }

        PieceType[] backRow =
        {
            PieceType.Rook, PieceType.Knight, PieceType.Bishop, PieceType.Queen,
            PieceType.King, PieceType.Bishop, PieceType.Knight, PieceType.Rook
        };

        for (int col = 0; col < 8; col++)
        {
            Board[0, col] = new ChessPiece { Color = PieceColor.Black, Type = backRow[col] };
            Board[7, col] = new ChessPiece { Color = PieceColor.White, Type = backRow[col] };
        }

        // If the human chose to play Black, the AI (White) needs to open
        _ = MaybeTriggerAiMove();
    }

    // ===================== AI opponent =====================

    private void OnOpponentModeChanged(ChangeEventArgs e)
    {
        Mode = Enum.Parse<OpponentMode>(e.Value?.ToString() ?? "Human");
        ResetGame();
    }

    private void OnDifficultyChanged(ChangeEventArgs e)
    {
        SelectedDifficulty = Enum.Parse<AiDifficulty>(e.Value?.ToString() ?? "Club");
        ResetGame();
    }

    private void OnHumanColorChanged(ChangeEventArgs e)
    {
        HumanColor = Enum.Parse<PieceColor>(e.Value?.ToString() ?? "White");
        ResetGame();
    }

    /// <summary>
    /// If it's the AI's turn, runs the search on a background thread (so
    /// the UI stays responsive and can show a "thinking" indicator), then
    /// plays the resulting move through the exact same AttemptMove path a
    /// human move would take.
    /// </summary>
    private async Task MaybeTriggerAiMove()
    {
        if (Mode != OpponentMode.Ai || GameOver || PendingPromotion) return;
        if (CurrentTurn != AiColor) return;

        AiThinking = true;
        StateHasChanged();
        await Task.Yield(); // let the "thinking" indicator actually render first

        Move? move = null;
        try
        {
            move = await Task.Run(() => Ai.GetBestMove(Board, AiColor, EnPassantTarget, SelectedDifficulty));
        }
        catch
        {
            // Defensive: never let a search bug take down the game
        }

        AiThinking = false;

        if (move != null)
        {
            await AttemptMove(move.From, move.To, move.Promotion);
        }
        else
        {
            StateHasChanged();
        }
    }

    // ===================== Clock =====================

    private void SetTimeControl(int minutes)
    {
        SelectedTimeControlMinutes = minutes;
        ResetGame(); // time control can't change mid-game — start fresh
    }

    /// <summary>Called right after the very first move is made — the clock
    /// doesn't run at all until then, so the opening move is unclocked.</summary>
    private void EnsureClockStarted()
    {
        if (!GameStarted)
        {
            GameStarted = true;
            StartClock();
        }
    }

    private void StartClock()
    {
        StopClock();
        GameClock = new System.Timers.Timer(1000);
        GameClock.Elapsed += OnClockTick;
        GameClock.AutoReset = true;
        GameClock.Start();
    }

    private void StopClock()
    {
        if (GameClock != null)
        {
            GameClock.Stop();
            GameClock.Elapsed -= OnClockTick;
            GameClock.Dispose();
            GameClock = null;
        }
    }

    private async void OnClockTick(object? sender, System.Timers.ElapsedEventArgs e)
    {
        if (GameOver || PendingPromotion) return;

        await InvokeAsync(async () =>
        {
            if (GameOver) return;

            if (CurrentTurn == PieceColor.White)
            {
                WhiteSecondsRemaining = Math.Max(0, WhiteSecondsRemaining - 1);
                if (WhiteSecondsRemaining == 0) { await HandleTimeOut(PieceColor.White); return; }
                if (WhiteSecondsRemaining <= 10) await PlaySound("tick");
            }
            else
            {
                BlackSecondsRemaining = Math.Max(0, BlackSecondsRemaining - 1);
                if (BlackSecondsRemaining == 0) { await HandleTimeOut(PieceColor.Black); return; }
                if (BlackSecondsRemaining <= 10) await PlaySound("tick");
            }

            StateHasChanged();
        });
    }

    private async Task HandleTimeOut(PieceColor colorThatRanOut)
    {
        StopClock();
        GameOver = true;
        string winner = colorThatRanOut == PieceColor.White ? "Black" : "White";
        string loser = colorThatRanOut == PieceColor.White ? "White" : "Black";
        StatusMessage = $"{loser} ran out of time! {winner} wins.";
        StateHasChanged();
        await PlaySound("gameOver");
    }

    private string FormatTime(int totalSeconds)
    {
        int m = totalSeconds / 60;
        int s = totalSeconds % 60;
        return $"{m}:{s:D2}";
    }

    public void Dispose()
    {
        StopClock();
    }

    // ===================== Selection / input handling =====================

    private async Task OnSquareClick(int row, int col)
    {
        if (GameOver || PendingPromotion || AiThinking) return;

        var square = new Square(row, col);
        var piece = Board[row, col];

        if (SelectedSquare == null)
        {
            SelectPiece(square, piece);
            return;
        }

        if (SelectedSquare.Row == row && SelectedSquare.Col == col)
        {
            DeselectPiece();
            return;
        }

        if (piece != null && piece.Color == CurrentTurn)
        {
            SelectPiece(square, piece);
            return;
        }

        await AttemptMove(SelectedSquare, square);
    }

    private void OnDragStart(int row, int col)
    {
        if (GameOver || PendingPromotion || AiThinking) return;
        SelectPiece(new Square(row, col), Board[row, col]);
    }

    private async Task OnDrop(int row, int col)
    {
        if (GameOver || PendingPromotion || AiThinking || SelectedSquare == null) return;

        if (SelectedSquare.Row == row && SelectedSquare.Col == col)
        {
            DeselectPiece();
            return;
        }

        var moved = await AttemptMove(SelectedSquare, new Square(row, col));
        if (!moved)
        {
            DeselectPiece();
        }
    }

    private void SelectPiece(Square square, ChessPiece? piece)
    {
        if (piece == null || piece.Color != CurrentTurn) return;
        SelectedSquare = square;
        ComputeLegalTargets(square);
    }

    private void DeselectPiece()
    {
        SelectedSquare = null;
        LegalTargets.Clear();
    }

    private void ComputeLegalTargets(Square from)
    {
        LegalTargets.Clear();
        var piece = Board[from.Row, from.Col];
        if (piece == null) return;

        for (int r = 0; r < 8; r++)
            for (int c = 0; c < 8; c++)
            {
                if (r == from.Row && c == from.Col) continue;
                var to = new Square(r, c);
                if (ChessRules.IsMoveValid(Board, piece, from, to, EnPassantTarget) && !ChessRules.WouldLeaveKingInCheck(Board, piece, from, to))
                    LegalTargets.Add((r, c));
            }

        if (piece.Type == PieceType.King)
        {
            if (ChessRules.CanCastle(Board, piece.Color, true)) LegalTargets.Add((from.Row, from.Col + 2));
            if (ChessRules.CanCastle(Board, piece.Color, false)) LegalTargets.Add((from.Row, from.Col - 2));
        }
    }

    // ===================== Move execution =====================

    /// <summary>
    /// Validates and (if legal) performs a move from `from` to `to`,
    /// including castling and en passant, updates captures, notation,
    /// promotion state, turn, game status, and plays a sound. If the
    /// move is a promotion and `autoPromoteTo` is supplied (used for AI
    /// moves), it resolves immediately instead of opening the picker.
    /// Returns true if the move was actually made.
    /// </summary>
    private async Task<bool> AttemptMove(Square from, Square to, PieceType? autoPromoteTo = null)
    {
        var piece = Board[from.Row, from.Col];
        if (piece == null || piece.Color != CurrentTurn) return false;
        if (from.Row == to.Row && from.Col == to.Col) return false;

        // ---- Castling ----
        if (piece.Type == PieceType.King && from.Row == to.Row && Math.Abs(to.Col - from.Col) == 2)
        {
            bool kingSide = to.Col > from.Col;
            if (!ChessRules.CanCastle(Board, piece.Color, kingSide)) return false;

            ChessRules.PerformCastle(Board, piece.Color, kingSide);
            EnPassantTarget = null;
            LastMoveFrom = from;
            LastMoveTo = to;
            SelectedSquare = null;
            LegalTargets.Clear();

            CurrentTurn = Opponent(CurrentTurn);
            EnsureClockStarted();
            UpdateGameStatus();
            await FinalizeMoveNotation(kingSide ? "O-O" : "O-O-O", "", isCapture: false, castled: true);
            await MaybeTriggerAiMove();
            return true;
        }

        // ---- Normal / en passant moves ----
        if (!ChessRules.IsMoveValid(Board, piece, from, to, EnPassantTarget)) return false;
        if (ChessRules.WouldLeaveKingInCheck(Board, piece, from, to)) return false;

        string pieceLetter = PieceLetter(piece.Type);
        var (capturedAtTo, capturedEnPassant, _, _) = ChessRules.ApplyMove(Board, piece, from, to);
        bool isCapture = capturedAtTo != null || capturedEnPassant != null;

        if (capturedAtTo != null)
        {
            if (capturedAtTo.Color == PieceColor.White) CapturedWhitePieces.Add(capturedAtTo);
            else CapturedBlackPieces.Add(capturedAtTo);
        }
        if (capturedEnPassant != null)
        {
            if (capturedEnPassant.Color == PieceColor.White) CapturedWhitePieces.Add(capturedEnPassant);
            else CapturedBlackPieces.Add(capturedEnPassant);
        }

        piece.HasMoved = true;
        LastMoveFrom = from;
        LastMoveTo = to;
        SelectedSquare = null;
        LegalTargets.Clear();

        EnPassantTarget = null;
        if (piece.Type == PieceType.Pawn && Math.Abs(to.Row - from.Row) == 2)
        {
            EnPassantTarget = new Square((to.Row + from.Row) / 2, to.Col);
        }

        string baseNotation = piece.Type == PieceType.Pawn
            ? (isCapture ? $"{(char)('a' + from.Col)}x{ToAlgebraic(to)}" : ToAlgebraic(to))
            : $"{pieceLetter}{(isCapture ? "x" : "")}{ToAlgebraic(to)}";

        // ---- Pawn promotion ----
        if (piece.Type == PieceType.Pawn && (to.Row == 0 || to.Row == 7))
        {
            if (autoPromoteTo.HasValue)
            {
                // AI move — resolve immediately, no modal
                piece.Type = autoPromoteTo.Value;
                string promoSuffix = $"={PieceLetter(autoPromoteTo.Value)}";

                CurrentTurn = Opponent(CurrentTurn);
                EnsureClockStarted();
                UpdateGameStatus();
                await FinalizeMoveNotation(baseNotation, promoSuffix, isCapture: isCapture, castled: false);
                await MaybeTriggerAiMove();
                return true;
            }

            // Human move — pause here, don't switch turns yet
            PendingPromotion = true;
            PromotionSquare = to;
            PendingMoveNotation = baseNotation;
            PendingMoveWasCapture = isCapture;
            await PlaySound(isCapture ? "capture" : "move");
            return true;
        }

        CurrentTurn = Opponent(CurrentTurn);
        EnsureClockStarted();
        UpdateGameStatus();
        await FinalizeMoveNotation(baseNotation, "", isCapture: isCapture, castled: false);
        await MaybeTriggerAiMove();
        return true;
    }

    private async Task CompletePromotion(PieceType chosenType)
    {
        if (!PendingPromotion || PromotionSquare == null) return;

        var piece = Board[PromotionSquare.Row, PromotionSquare.Col];
        if (piece != null)
        {
            piece.Type = chosenType;
        }

        PendingPromotion = false;
        PromotionSquare = null;

        CurrentTurn = Opponent(CurrentTurn);
        EnsureClockStarted();
        UpdateGameStatus();

        string promoSuffix = $"={PieceLetter(chosenType)}";
        await FinalizeMoveNotation(PendingMoveNotation ?? "", promoSuffix, isCapture: PendingMoveWasCapture, castled: false);
        PendingMoveNotation = null;

        await MaybeTriggerAiMove();
    }

    private async Task FinalizeMoveNotation(string baseNotation, string suffix, bool isCapture, bool castled)
    {
        bool checkNow = CurrentTurn == PieceColor.White ? WhiteInCheck : BlackInCheck;
        string checkSuffix = GameOver && checkNow ? "#" : (checkNow ? "+" : "");
        MoveHistory.Add(baseNotation + suffix + checkSuffix);

        string sound = GameOver ? "gameOver"
            : checkNow ? "check"
            : castled ? "castle"
            : isCapture ? "capture"
            : "move";

        await PlaySound(sound);
    }

    private async Task PlaySound(string type)
    {
        try
        {
            await JS.InvokeVoidAsync("chessSounds.play", type);
        }
        catch
        {
            // JS interop not ready (e.g. mid-prerender) — safe to ignore
        }
    }

    private string PieceLetter(PieceType t) => t switch
    {
        PieceType.King => "K",
        PieceType.Queen => "Q",
        PieceType.Rook => "R",
        PieceType.Bishop => "B",
        PieceType.Knight => "N",
        _ => ""
    };

    private string ToAlgebraic(Square sq) => $"{(char)('a' + sq.Col)}{8 - sq.Row}";

    private PieceColor Opponent(PieceColor c) => c == PieceColor.White ? PieceColor.Black : PieceColor.White;

    private void UpdateGameStatus()
    {
        bool inCheck = ChessRules.IsKingInCheck(Board, CurrentTurn);
        bool hasMoves = ChessRules.HasAnyLegalMoves(Board, CurrentTurn, EnPassantTarget);
        string playerName = CurrentTurn == PieceColor.White ? "White" : "Black";

        if (inCheck && !hasMoves)
        {
            GameOver = true;
            StopClock();
            string winner = CurrentTurn == PieceColor.White ? "Black" : "White";
            StatusMessage = $"Checkmate! {winner} wins.";
        }
        else if (!inCheck && !hasMoves)
        {
            GameOver = true;
            StopClock();
            StatusMessage = "Stalemate! The game is a draw.";
        }
        else if (inCheck)
        {
            StatusMessage = $"{playerName} is in check!";
        }
        else
        {
            StatusMessage = "";
        }
    }
}
