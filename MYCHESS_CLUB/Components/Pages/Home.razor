@page "/"

<PageTitle> LUCKY STARS CHESS CLUB</PageTitle>

<div class="hero">
    <div class="hero-content">
        <div class="chess-symbol">♟️</div>

        <h1>⭐ LUCKY STARS CHESS CLUB</h1>

        <p class="tagline">
            Checkmate the Odds
        </p>

        <p>
            A welcoming community for chess players of all
            skill levels.
        </p>

        <a href="/membership" class="join-button">
            Join Our Club
        </a>
    </div>
</div>

<div class="club-section">

    <h2>Welcome to LUCKY STARS CHESS CLUB</h2>

    <p>
        We bring chess players together to learn new strategies,
        compete in tournaments, and enjoy the game we love.
    </p>

    <div class="features">

        <div class="feature-card">
            <div class="feature-icon">♟️</div>
            <h3>Learn</h3>
            <p>
                Improve your chess skills through training
                and practice.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🏆</div>
            <h3>Compete</h3>
            <p>
                Take part in tournaments and challenge
                other players.
            </p>
        </div>

        <div class="feature-card">
            <div class="feature-icon">🤝</div>
            <h3>Connect</h3>
            <p>
                Meet other chess enthusiasts and become
                part of our community.
            </p>
        </div>

    </div>

</div>