@page "/events"
@rendermode InteractiveServer

<PageTitle>Events</PageTitle>

<h1>Club Events 📅</h1>

<p>
    See what is happening at our CHESS CLUB.
</p>

<h2>Upcoming Events</h2>

<div class="event-card">
    <h3>♟️ Beginner Chess Training</h3>

    <p>
        Learn the basics of chess and improve your understanding
        of the game.
    </p>

    <p><strong>Date:</strong> Every Saturday</p>
    <p><strong>Time:</strong> 10:00 AM</p>
</div>

<div class="event-card">
    <h3>🏆 Club Tournament</h3>

    <p>
        Test your skills against other club members.
    </p>

    <p><strong>Date:</strong> To be announced</p>
</div>

<h2>Club Activities</h2>

<ul>
    <li>♟️ Chess lessons</li>
    <li>🏆 Tournaments</li>
    <li>🤝 Friendly matches</li>
    <li>🧠 Chess analysis sessions</li>
</ul>

<button @onclick="ShowMessage">
    Click Me
</button>

@if (messageVisible)
{
    <p><strong>Welcome to our chess club! ♟️</strong></p>
}

@code {
    bool messageVisible = false;

    void ShowMessage()
    {
        messageVisible = true;
    }
}